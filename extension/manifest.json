{
  "manifest_version": 3,
  "name": "ZDownloader 助手",
  "version": "1.7.2",
  "description": "接管浏览器默认下载,交给 ZDownloader 多线程引擎;嗅探网页中的视频/音频/HLS 流媒体资源。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ZDownloader 助手",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "permissions": [
    "downloads",
    "webRequest",
    "cookies",
    "contextMenus",
    "storage",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ]
}
